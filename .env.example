# ---- Required: SerpApi (free plan, no card) ------------------------------
# Sign up at https://serpapi.com/users/sign_up and copy the key from
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Safety rail so testing can never burn the whole free allowance.
# The free plan is 250 successful searches per month; cached searches are free.
SERPAPI_MONTHLY_BUDGET=200
SERPAPI_CALLS_PER_PLAN=6
SERPAPI_COUNTRY=in
SERPAPI_LANGUAGE=en

# ---- Optional: free-tier LLM that writes the itinerary --------------------
# groq   -> https://console.groq.com/keys      (no card, rate-limited only)
# gemini -> https://aistudio.google.com/apikey (free Flash models)
# Leave both blank and the app falls back to a rule-based itinerary.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Housekeeping ---------------------------------------------------------
PORT=3000
CACHE_DIR=.cache
CACHE_TTL_HOURS=72
APP_USER_AGENT=AI-Travel-Intelligence/1.0 (your-email@example.com)
